<!DOCTYPE html>
<head>
    <title>{{ title }}</title>


    <script type="module">
        import init, { run } from './client/index.js';
        async function main() {
            await init();
            run();
        }
        main();
        window["{{key}}"] = 42;
    </script>
    <style>
        body {
            background-color: darkslateblue;
            color: lightgray;
        }

        .wall-clock {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 80vh;
            background: #333333;
        }

        .clock {
            border-radius: 100%;
            background: #ffffff;
            border: 5px solid white;
            box-shadow: inset 2px 3px 8px 0 rgba(0, 0, 0, 0.1);
        }

        .wrap {
            overflow: hidden;
            position: relative;
            width: 350px;
            height: 350px;
            border-radius: 100%;
        }
        
        .minute,
        .hour {
            position: absolute;
            height: 100px;
            width: 6px;
            margin: auto;
            top: -27%;
            left: 0;
            bottom: 0;
            right: 0;
            background: black;
            transform-origin: bottom center;
            box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.4);
            z-index: 1;
        }

        .minute {
            position: absolute;
            height: 130px;
            width: 4px;
            top: -38%;
            left: 0;
            box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.4);
        }

        .second {
            position: absolute;
            height: 90px;
            width: 2px;
            margin: auto;
            top: -26%;
            left: 0;
            bottom: 0;
            right: 0;
            border-radius: 4px;
            background: #FF4B3E;
            transform-origin: bottom center;
            z-index: 1;
        }

        .dot {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 12px;
            height: 12px;
            border-radius: 100px;
            background: white;
            border: 2px solid #1b1b1b;
            border-radius: 100px;
            margin: auto;
            z-index: 1;
        }
    </style>
</head>
<body>
    <fieldset>
        <horfimbor-auth endpoint={{endpoint}} auth-endpoint={{auth_endpoint}} account-name={{account_name}} jwt={{jwt}} ></horfimbor-auth>
    </fieldset>
</body>